{
  "name": "omp-make-advisor",
  "version": "0.0.1",
  "description": "OMP extension that interviews a project and emits the watchdogs that guard it",
  "type": "module",
  "main": "./index.ts",
  "omp": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test test/*.test.ts",
    "test:tui": "bun test test/tui/",
    "probe": "omp -e ./index.ts -p \"reply with the single word ready\"",
    "test:e2e": "OMA_E2E=1 bun test test/e2e/",
    "gallery": "bun run scripts/gallery.ts"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.0.0"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.1.12",
    "@oh-my-pi/pi-tui": "18.1.12",
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
